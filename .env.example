# ==============================================================================
# TRAYMBHKAM TOUR AND TRAVELS (HARIDWAR) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this to .env.local for local development or paste into Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (OPTIONAL)
# If left empty, the CRM functions seamlessly in local-first browser storage mode.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. META WHATSAPP CLOUD API (FOR WHATSAPP DESK & VOUCHER NOTIFICATIONS)
# Obtain from https://developers.facebook.com -> WhatsApp -> API Setup
# Can also be entered dynamically in the CRM's /settings page.
# ------------------------------------------------------------------------------
META_WA_PHONE_NUMBER_ID=
NEXT_PUBLIC_META_WA_PHONE_NUMBER_ID=
META_WABA_ID=
NEXT_PUBLIC_META_WABA_ID=
META_WA_ACCESS_TOKEN=
NEXT_PUBLIC_META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_VERIFY_TOKEN=traymbhkam_wa_webhook_token_2026

# ------------------------------------------------------------------------------
# 3. AI SERVICES (OPTIONAL - FOR ITINERARY BUILDER & AI SALES AGENT)
# ------------------------------------------------------------------------------
# OpenRouter API Key for WhatsApp sales conversational agent & voice note transcription
OPENROUTER_API_KEY=

# Gemini API Key for AI Itinerary generator
NEXT_PUBLIC_GEMINI_API_KEY=

# OpenAI API Key fallback for Itinerary generator
NEXT_PUBLIC_OPENAI_KEY=
